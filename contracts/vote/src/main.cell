module agoraseal::vote

// The external adapter binds CKB coordinates only. All voting decisions below
// are executable CellScript. See the exact declaration in Cell.toml.
action cast(
    witness deposit_height: u64,
    witness proposal_height: u64,
) -> u64 {
    verification
        let outputs = ckb::cell_count(source::group_output(0))
        // Input Locks authorize reclamation; the tally interprets its effect.
        if outputs == 0 { return 0 }
        require outputs == 1
        let ballot = source::group_output(0)
        let dao = source::cell_dep(0)
        let proposal = source::cell_dep(1)
        let inputs = ckb::cell_count(source::input(0))
        require inputs > 0 && inputs <= 128
        require ckb::cell_count(source::output(0)) <= 128

        require ckb::cell_data_size(proposal) == 188
        require ckb::cell_data_u64_le(proposal, 0) == 3544421208354211649
        require ckb::cell_data_u32_le(proposal, 72) > 0
        require ckb::cell_data_u64_le(proposal, 76) > 0
        require ckb::cell_data_u64_le(proposal, 84) > 0
        ckb::require_cell_type_hash(proposal, ckb::cell_type_args32(ballot))
        require ckb::cell_type_hash_type(ballot) == 4
        require hash_blake2b(ckb::cell_type_code_hash(ballot)) == ckb::cell_data_blake2b_span(proposal, 40, 32)
        require hash_blake2b(ckb::cell_type_hash(dao)) == ckb::cell_data_blake2b_span(proposal, 156, 32)
        require ckb::cell_data_size(dao) == 8
        require ckb::cell_data_u64_le(dao, 0) == 0
        require deposit_height < proposal_height

        require ckb::cell_data_size(ballot) == 53
        require ckb::cell_data_u64_le(ballot, 0) == 3544409135151204161
        require ckb::cell_data_u8(ballot, 52) <= 1
        require ckb::cell_data_u64_le(ballot, 44) == ckb::cell_capacity(dao)
        require ckb::cell_capacity(dao) > 0
        let owner = ckb::cell_lock_hash(dao)
        ckb::require_cell_lock_hash(ballot, owner)
        let deposit_tx_digest = ckb::cell_data_blake2b_span(ballot, 8, 32)
        let deposit_index = ckb::cell_data_u32_le(ballot, 40)
        let mut authorized = false
        for i in 0..inputs {
            let input = source::input(i)
            if ckb::cell_lock_hash(input) == owner { authorized = true }
            if hash_blake2b(ckb::input_out_point_tx_hash(input)) == deposit_tx_digest {
                require ckb::input_out_point_index(input) as u64 != deposit_index
            }
        }
        require authorized

        let mut context = Vec::new()
        // Fixed 52-byte argv materialization; no unbounded collection is passed.
        context.push(ckb::cell_data_u8(ballot, 8) as u8)
        context.push(ckb::cell_data_u8(ballot, 9) as u8)
        context.push(ckb::cell_data_u8(ballot, 10) as u8)
        context.push(ckb::cell_data_u8(ballot, 11) as u8)
        context.push(ckb::cell_data_u8(ballot, 12) as u8)
        context.push(ckb::cell_data_u8(ballot, 13) as u8)
        context.push(ckb::cell_data_u8(ballot, 14) as u8)
        context.push(ckb::cell_data_u8(ballot, 15) as u8)
        context.push(ckb::cell_data_u8(ballot, 16) as u8)
        context.push(ckb::cell_data_u8(ballot, 17) as u8)
        context.push(ckb::cell_data_u8(ballot, 18) as u8)
        context.push(ckb::cell_data_u8(ballot, 19) as u8)
        context.push(ckb::cell_data_u8(ballot, 20) as u8)
        context.push(ckb::cell_data_u8(ballot, 21) as u8)
        context.push(ckb::cell_data_u8(ballot, 22) as u8)
        context.push(ckb::cell_data_u8(ballot, 23) as u8)
        context.push(ckb::cell_data_u8(ballot, 24) as u8)
        context.push(ckb::cell_data_u8(ballot, 25) as u8)
        context.push(ckb::cell_data_u8(ballot, 26) as u8)
        context.push(ckb::cell_data_u8(ballot, 27) as u8)
        context.push(ckb::cell_data_u8(ballot, 28) as u8)
        context.push(ckb::cell_data_u8(ballot, 29) as u8)
        context.push(ckb::cell_data_u8(ballot, 30) as u8)
        context.push(ckb::cell_data_u8(ballot, 31) as u8)
        context.push(ckb::cell_data_u8(ballot, 32) as u8)
        context.push(ckb::cell_data_u8(ballot, 33) as u8)
        context.push(ckb::cell_data_u8(ballot, 34) as u8)
        context.push(ckb::cell_data_u8(ballot, 35) as u8)
        context.push(ckb::cell_data_u8(ballot, 36) as u8)
        context.push(ckb::cell_data_u8(ballot, 37) as u8)
        context.push(ckb::cell_data_u8(ballot, 38) as u8)
        context.push(ckb::cell_data_u8(ballot, 39) as u8)
        context.push(ckb::cell_data_u8(ballot, 40) as u8)
        context.push(ckb::cell_data_u8(ballot, 41) as u8)
        context.push(ckb::cell_data_u8(ballot, 42) as u8)
        context.push(ckb::cell_data_u8(ballot, 43) as u8)
        context.push(((deposit_height >> 0) & 255) as u8)
        context.push(((deposit_height >> 8) & 255) as u8)
        context.push(((deposit_height >> 16) & 255) as u8)
        context.push(((deposit_height >> 24) & 255) as u8)
        context.push(((deposit_height >> 32) & 255) as u8)
        context.push(((deposit_height >> 40) & 255) as u8)
        context.push(((deposit_height >> 48) & 255) as u8)
        context.push(((deposit_height >> 56) & 255) as u8)
        context.push(((proposal_height >> 0) & 255) as u8)
        context.push(((proposal_height >> 8) & 255) as u8)
        context.push(((proposal_height >> 16) & 255) as u8)
        context.push(((proposal_height >> 24) & 255) as u8)
        context.push(((proposal_height >> 32) & 255) as u8)
        context.push(((proposal_height >> 40) & 255) as u8)
        context.push(((proposal_height >> 48) & 255) as u8)
        context.push(((proposal_height >> 56) & 255) as u8)
        ckb::trusted_spawn_wait_cell_dep_hex4(
            2, Hash::from_bytes(b"\x57\x39\xd9\xd4\x92\x8e\xe4\xed\x0a\xbe\x51\x45\x6f\x70\x8f\xb1\x55\xe7\xd5\x9c\xfe\x3d\x76\xf0\x69\x80\xb1\xb3\x06\x02\x55\xc8"), context, 36, 8, 8, 0
        )
        return 0
}

