module agoraseal::funded_proposal

// Immutable unique state. Business policy stays here; the external adapter
// authenticates only Type-ID and exact CKB header coordinates.
action settle(
    witness statement_hash: Hash,
    witness recipient: [u8; 20],
    witness recipient_hash: Hash,
) -> u64 {
    verification
        let inputs = ckb::cell_count(source::group_input(0))
        require inputs <= 1
        require ckb::cell_count(source::group_output(0)) == 1
        let output = source::group_output(0)
        require ckb::cell_type_hash(output) == ckb::cell_type_hash(source::output(0))
        require ckb::cell_type_hash_type(output) == 4
        // Exact arguments are additionally checked by the coordinate adapter.
        let unique_id = ckb::cell_type_args32(output)
        require unique_id != Hash::zero()
        let expected_payee = script::new(
            Hash::from_bytes(b"\x9b\xd7\xe0\x6f\x3e\xcf\x4b\xe0\xf2\xfc\xd2\x18\x8b\x23\xf1\xb9\xfc\xc8\x8e\x5d\x4b\x65\xa8\x63\x7b\x17\x72\x3b\xbd\xa3\xcc\xe8"),
            script::hash_type_type(), script::args(recipient)
        )
        require script::hash(expected_payee) == ckb::script_hash(recipient_hash)
        require hash_blake2b(recipient_hash) == ckb::cell_data_blake2b_span(output, 92, 32)
        let mut context = Vec::new()
        context.push(inputs as u8)
        if inputs == 0 {
            require ckb::cell_count(source::input(0)) > 0
            require ckb::cell_count(source::input(0)) <= 128
            require ckb::cell_count(source::output(0)) <= 128
            require ckb::cell_data_size(output) == 188
            require ckb::cell_data_u64_le(output, 0) == 3544421208354211649
            let duration = ckb::cell_data_u32_le(output, 72)
            require duration > 0 && duration <= 16
            require ckb::cell_data_u64_le(output, 76) > 0
            let amount = ckb::cell_data_u64_le(output, 84)
            require amount >= 6100000000
            require ckb::cell_data_blake2b_span(output, 40, 32) == hash_blake2b(Hash::from_bytes(b"\xe5\x09\x0f\xbb\xe4\x06\x88\x48\x66\xf5\x7b\x51\xa2\x2e\x41\xe6\x08\x7f\xdb\x51\x95\xd0\x9f\xc9\xb9\x57\xe1\x88\xf8\xa9\xbb\x74"))
            let dao = script::new(
                Hash::from_bytes(b"\x82\xd7\x6d\x1b\x75\xfe\x2f\xd9\xa2\x7d\xfb\xaa\x65\xa0\x39\x22\x1a\x38\x0d\x76\xc9\x26\xf3\x78\xd3\xf8\x1c\xf3\xe7\xe1\x3f\x2e"),
                script::hash_type_type(), script::args_empty()
            )
            let dao_hash = Hash::from_bytes(b"\xcc\x77\xc4\xde\xac\x05\xd6\x8a\xb5\xb2\x68\x28\xf0\xbf\x45\x65\xa8\xd7\x31\x13\xd7\xbb\x7e\x92\xb8\x36\x2b\x8a\x74\xe5\x8e\x58")
            require script::hash(dao) == ckb::script_hash(dao_hash)
            require hash_blake2b(dao_hash) == ckb::cell_data_blake2b_span(output, 156, 32)
            require ckb::cell_lock_hash_type(output) == 4
            require ckb::cell_lock_code_hash(output) == Hash::from_bytes(b"\x42\x6f\xc4\x17\xf5\x40\x2a\x7d\x5c\xa7\x83\x63\x35\x7b\x9d\xe3\x1f\xbd\x94\x96\x80\x6a\xd5\x92\x49\xd2\xc5\xf3\xfc\x3a\x78\xd9")
            let funder = source::input(0)
            require ckb::cell_data_size(funder) == 0
            require !ckb::cell_has_type(funder)
            ckb::require_cell_lock_hash(funder, ckb::cell_lock_args32(output))
            require amount >= ckb::cell_occupied_capacity(funder)
            let occupied = ckb::cell_occupied_capacity(output)
            require occupied <= 18446744073709551615 - 27700000000
            let receipt_capacity = occupied + 27700000000
            require receipt_capacity <= 18446744073709551615 - amount
            let minimum = receipt_capacity + amount
            require ckb::cell_capacity(output) >= minimum
            require ckb::cell_capacity(output) - minimum <= 100000
            context.push(ckb::cell_data_u8(output, 8) as u8)
            context.push(ckb::cell_data_u8(output, 9) as u8)
            context.push(ckb::cell_data_u8(output, 10) as u8)
            context.push(ckb::cell_data_u8(output, 11) as u8)
            context.push(ckb::cell_data_u8(output, 12) as u8)
            context.push(ckb::cell_data_u8(output, 13) as u8)
            context.push(ckb::cell_data_u8(output, 14) as u8)
            context.push(ckb::cell_data_u8(output, 15) as u8)
            context.push(ckb::cell_data_u8(output, 16) as u8)
            context.push(ckb::cell_data_u8(output, 17) as u8)
            context.push(ckb::cell_data_u8(output, 18) as u8)
            context.push(ckb::cell_data_u8(output, 19) as u8)
            context.push(ckb::cell_data_u8(output, 20) as u8)
            context.push(ckb::cell_data_u8(output, 21) as u8)
            context.push(ckb::cell_data_u8(output, 22) as u8)
            context.push(ckb::cell_data_u8(output, 23) as u8)
            context.push(ckb::cell_data_u8(output, 24) as u8)
            context.push(ckb::cell_data_u8(output, 25) as u8)
            context.push(ckb::cell_data_u8(output, 26) as u8)
            context.push(ckb::cell_data_u8(output, 27) as u8)
            context.push(ckb::cell_data_u8(output, 28) as u8)
            context.push(ckb::cell_data_u8(output, 29) as u8)
            context.push(ckb::cell_data_u8(output, 30) as u8)
            context.push(ckb::cell_data_u8(output, 31) as u8)
            context.push(ckb::cell_data_u8(output, 32) as u8)
            context.push(ckb::cell_data_u8(output, 33) as u8)
            context.push(ckb::cell_data_u8(output, 34) as u8)
            context.push(ckb::cell_data_u8(output, 35) as u8)
            context.push(ckb::cell_data_u8(output, 36) as u8)
            context.push(ckb::cell_data_u8(output, 37) as u8)
            context.push(ckb::cell_data_u8(output, 38) as u8)
            context.push(ckb::cell_data_u8(output, 39) as u8)
            context.push(0 as u8)
            context.push(0 as u8)
            context.push(0 as u8)
            context.push(0 as u8)
