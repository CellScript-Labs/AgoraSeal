            context.push(0 as u8)
            context.push(0 as u8)
            context.push(0 as u8)
            context.push(0 as u8)
            context.push(0 as u8)
        } else {
            require ckb::cell_count(source::input(0)) == 1
            require ckb::cell_count(source::output(0)) == 2
            let before = source::group_input(0)
            // A 465-byte receipt cannot transition, be burned or release again.
            require ckb::cell_data_size(before) == 188
            require ckb::cell_data_size(output) == 465
            require ckb::cell_lock_hash(output) == ckb::cell_lock_hash(before)
            for i in 0..188 {
                require ckb::cell_data_u8(before, i) == ckb::cell_data_u8(output, i)
            }
            require statement_hash == ckb::cell_data_blake2b_span(output, 188, 277)
            require ckb::cell_data_blake2b_span(output, 196, 32) == ckb::cell_data_blake2b_span(before, 8, 32)
            require hash_blake2b(ckb::cell_type_hash(before)) == ckb::cell_data_blake2b_span(output, 228, 32)
            require hash_blake2b(ckb::input_out_point_tx_hash(before)) == ckb::cell_data_blake2b_span(output, 260, 32)
            require ckb::input_out_point_index(before) as u64 == ckb::cell_data_u32_le(output, 292)
            require hash_blake2b(ckb::cell_data_hash(before)) == ckb::cell_data_blake2b_span(output, 296, 32)
            let start = ckb::cell_data_u64_le(output, 392)
            let duration = ckb::cell_data_u32_le(before, 72) as u64
            require start <= 18446744073709551615 - duration
            require ckb::cell_data_u64_le(output, 400) == start + duration
            let yes = ckb::cell_data_u64_le(output, 408)
            let no = ckb::cell_data_u64_le(output, 416)
            require yes <= 18446744073709551615 - no
            let passed = ckb::cell_data_u8(output, 464)
            require passed <= 1
            require (passed == 1) == (yes > no && yes + no >= ckb::cell_data_u64_le(before, 76))
            let entry = witness::bounded_entry(source::group_input(0), 92)
            require entry.size == 92
            let mut binding = Vec::new()
            binding.push(witness::byte(entry, 8) as u8)
            binding.push(witness::byte(entry, 9) as u8)
            binding.push(witness::byte(entry, 10) as u8)
            binding.push(witness::byte(entry, 11) as u8)
            binding.push(witness::byte(entry, 12) as u8)
            binding.push(witness::byte(entry, 13) as u8)
            binding.push(witness::byte(entry, 14) as u8)
            binding.push(witness::byte(entry, 15) as u8)
            binding.push(witness::byte(entry, 16) as u8)
            binding.push(witness::byte(entry, 17) as u8)
            binding.push(witness::byte(entry, 18) as u8)
            binding.push(witness::byte(entry, 19) as u8)
            binding.push(witness::byte(entry, 20) as u8)
            binding.push(witness::byte(entry, 21) as u8)
            binding.push(witness::byte(entry, 22) as u8)
            binding.push(witness::byte(entry, 23) as u8)
            binding.push(witness::byte(entry, 24) as u8)
            binding.push(witness::byte(entry, 25) as u8)
            binding.push(witness::byte(entry, 26) as u8)
            binding.push(witness::byte(entry, 27) as u8)
            binding.push(witness::byte(entry, 28) as u8)
            binding.push(witness::byte(entry, 29) as u8)
            binding.push(witness::byte(entry, 30) as u8)
            binding.push(witness::byte(entry, 31) as u8)
            binding.push(witness::byte(entry, 32) as u8)
            binding.push(witness::byte(entry, 33) as u8)
            binding.push(witness::byte(entry, 34) as u8)
            binding.push(witness::byte(entry, 35) as u8)
            binding.push(witness::byte(entry, 36) as u8)
            binding.push(witness::byte(entry, 37) as u8)
            binding.push(witness::byte(entry, 38) as u8)
            binding.push(witness::byte(entry, 39) as u8)
            ckb::trusted_spawn_wait_cell_dep_hex4(
                0, Hash::from_bytes(b"\xa1\x4f\x73\x48\x04\x77\xfb\x0d\x2b\xdd\xec\x5b\x9d\x7d\xf3\x8a\xd0\x3c\x2c\xa8\x61\x44\x1d\x66\xde\x00\x86\x20\x43\xe8\x5b\x02"), binding, 32, 0, 0, 0
            )
            context.push(ckb::cell_data_u8(before, 8) as u8)
            context.push(ckb::cell_data_u8(before, 9) as u8)
            context.push(ckb::cell_data_u8(before, 10) as u8)
            context.push(ckb::cell_data_u8(before, 11) as u8)
            context.push(ckb::cell_data_u8(before, 12) as u8)
            context.push(ckb::cell_data_u8(before, 13) as u8)
            context.push(ckb::cell_data_u8(before, 14) as u8)
